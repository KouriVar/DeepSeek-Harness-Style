{
  "name": "dsh-style",
  "version": "0.2.4",
  "description": "DeepSeek Harness 客户端外观插件：内嵌/经典布局、侧栏对齐、任务监控与同款外观预设。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "host",
    "icons",
    "tools/icons"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "theme",
    "appearance"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "icons:index": "node tools/icon-studio/index.mjs",
    "icons:studio": "node tools/icon-studio/service.mjs start --open",
    "icons:test": "node --test tools/icon-studio/test/studio.test.mjs",
    "icons:stop": "node tools/icon-studio/service.mjs stop",
    "icons:build": "node tools/icons/build.mjs",
    "icons:check": "node tools/icons/build.mjs --check"
  }
}
