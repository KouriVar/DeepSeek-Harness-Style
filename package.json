{
  "name": "dsh-style",
  "version": "0.1.0",
  "description": "DeepSeek Harness 客户端外观插件：原生「外观」设置页，支持经典/内嵌布局等可逆样式定制。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "theme",
    "appearance"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "icons:index": "node tools/icon-studio/index.mjs",
    "icons:studio": "node tools/icon-studio/service.mjs start --open",
    "icons:test": "node --test tools/icon-studio/test/studio.test.mjs",
    "icons:stop": "node tools/icon-studio/service.mjs stop"
  }
}
